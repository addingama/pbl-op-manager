{
  "name": "pbl-op-manager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint //#lint:root",
    "lint:root": "eslint --max-warnings=0 \"*.js\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @pbl/database db:migrate",
    "db:deploy": "pnpm --filter @pbl/database db:deploy",
    "db:reset": "pnpm --filter @pbl/database db:reset",
    "db:seed": "pnpm --filter @pbl/database db:seed",
    "create-admin": "pnpm --filter @pbl/api create-admin",
    "compose:config": "docker compose -f docker-compose.yml config"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
