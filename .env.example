# Local development only. Copy to .env and adjust; never commit .env.
# Host port 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_USER=pbl
POSTGRES_PASSWORD=pbl_dev_password
POSTGRES_DB=pbl_openplay
POSTGRES_PORT=5433
DATABASE_URL=postgresql://pbl:pbl_dev_password@localhost:5433/pbl_openplay
