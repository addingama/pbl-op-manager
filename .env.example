# Local development only. Copy to .env and adjust; never commit .env.
# Host port 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_USER=pbl
POSTGRES_PASSWORD=pbl_dev_password
POSTGRES_DB=pbl_openplay
POSTGRES_PORT=5433
DATABASE_URL=postgresql://pbl:pbl_dev_password@localhost:5433/pbl_openplay
# Dev seed admin (pnpm db:seed). Dev only — never reuse these values elsewhere.
SEED_ADMIN_EMAIL=admin@pbl.local
SEED_ADMIN_PASSWORD=pbl-dev-admin
# Integration tests default to "<DATABASE_URL db name>_test" on the same server.
# TEST_DATABASE_URL=postgresql://pbl:pbl_dev_password@localhost:5433/pbl_openplay_test
