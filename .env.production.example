# VPS production — copy to .env on the server (never commit .env).

# Public hostname (for TLS and nginx https.conf)
DOMAIN=openplay.example.com
CERTBOT_EMAIL=you@example.com

# Postgres (not published to the host; internal Docker network only)
POSTGRES_USER=pbl
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=pbl_openplay

# Optional backup retention (days)
BACKUP_RETENTION_DAYS=14

# Bootstrap first admin (one-time; use docker compose run — see docs/DEPLOYMENT.md)
# CREATE_ADMIN_EMAIL=admin@example.com
# CREATE_ADMIN_PASSWORD=change-me
# CREATE_ADMIN_NAME=Addin
